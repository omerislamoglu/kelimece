rules_version = '2';

// Kelimece Firestore Guvenlik Kurallari
// Firebase Console > Firestore > Rules sekmesine yapistir

service cloud.firestore {
  match /databases/{database}/documents {
    // Kullanici verisi — sadece kendi verisini okuyabilir/yazabilir
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Diger tum koleksiyonlara erisimi engelle
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
